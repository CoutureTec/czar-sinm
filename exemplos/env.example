# Copie para .env e preencha:  cp env.example .env

# ---- Ambiente --------------------------------------------------------------
# hml | prd | <customizado>
SINM_AMBIENTE=hml
# Ambiente customizado (SINM_AMBIENTE diferente de hml/prd) exige as três:
# SINM_BACKEND_URL=https://endereco-da-api
# SINM_KEYCLOAK=https://endereco-do-keycloak/realms
# SINM_KEYCLOAK_REALM=nome-do-realm
# Proxy HTTP(S), se a sua rede exigir:
# SINM_PROXY=http://proxy.exemplo:3128

# ---- Credenciais (fornecidas pela equipe SiNM) ----------------------------
# Client ID = CNPJ da empresa, sem máscara
SINM_CLIENT_ID=00000000000000
SINM_CLIENT_SECRET=chave-secreta-do-client

# client_credentials (padrão, integração sistema a sistema) | password (usuário)
SINM_GRANT_TYPE=client_credentials
# Só para SINM_GRANT_TYPE=password:
# SINM_USERNAME=usuario@empresa.com.br
# SINM_PASSWORD=sua-senha

# ---- Fonte de dados -------------------------------------------------------
# json → dados/glebas.json | csv → dados/csv/
SINM_FONTE=json
# Caminho do arquivo/pasta (opcional; padrão: o da fonte escolhida)
# SINM_DADOS=dados/glebas.json

# CNPJ do operador da gleba e do laboratório, quando os dados não trazem
# (opcional; padrão: SINM_CLIENT_ID)
# SINM_CNPJ_OPERADOR=00000000000000
# SINM_CNPJ_LABORATORIO=00000000000000

# Atualiza as datas dos dados de EXEMPLO para que continuem válidas hoje.
# Desligue (nao) ao usar seus próprios dados.
SINM_AJUSTAR_DATAS=sim
